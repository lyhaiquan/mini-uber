# Expo / React Native ecosystem assumes flat node_modules (yarn/npm style).
# pnpm strict mode hides "implicit peer" deps that Metro / Babel / Expo runtime
# expect to be hoisted. `node-linker=hoisted` switches the workspace to a flat
# layout, matching Expo's official monorepo guidance.
#
# Web apps remain on React 18 while Expo SDK 54 mobile apps use React 19.
# pnpm still resolves the app-local version first for each workspace package.
node-linker=hoisted
