NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-token-here

# Internal (server-side) URL the Next.js route handlers use to call the backend.
# In Docker compose, set to http://backend:3000/api/v1. Defaults to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL_INTERNAL=http://localhost:3000/api/v1
