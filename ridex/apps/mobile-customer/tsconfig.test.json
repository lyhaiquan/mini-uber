{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "isolatedModules": false,
    "types": ["jest", "node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/lib/**/*.ts",
    "jest.setup.js",
    "../../packages/shared-types/src/**/*.ts"
  ]
}
